generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Rsvp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  guests    Int      @default(1)
  status    String
  createdAt DateTime @default(now())
}