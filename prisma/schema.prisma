generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Rsvp {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  guests    Int      @default(1)
  status    String
  createdAt DateTime @default(now())
}
